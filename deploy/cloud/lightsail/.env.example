# Bonito demo tenant — Lightsail compose projects (shared env)
# Usage: docker compose --env-file ~/stack/.env -p <project> -f <dir>/docker-compose.yml up -d

# Shared passwords (demo tenant — change for anything public)
DB_POSTGRES_PASSWORD=postgres
DB_MYSQL_PASSWORD=root
DB_MARIADB_PASSWORD=root

# Bonito
BONITO_API_KEY=change-me
BONITO_TOP_N=10

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# Cloudflare tunnel (grafana/api under *.sofe.dev)
TUNNEL_TOKEN=