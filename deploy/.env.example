# Bonito OSS — deploy configuration template (BON-005).
# Copy to `.env` next to deploy/docker-compose.yml, or rely on the defaults.

# ── Collector (bon-001) ──────────────────────────────────────────────
# Read-only PostgreSQL DSN. The bonito_ro role is created by deploy/init-fixture.sql.
BONITO_DSN=postgresql://bonito_ro:change-me@db:5432/app
BONITO_TOP_N=20
BONITO_PROM_PORT=9187

# ── Store (bon-002) ──────────────────────────────────────────────────
# Collector pushes every snapshot here.
BONITO_STORE_URL=http://store:8000
BONITO_RETENTION_DAYS=7

# ── API (bon-003) ────────────────────────────────────────────────────
# REQUIRED for the API/MCP. Change this!
BONITO_API_KEY=change-me

# ── MCP (bon-004) ────────────────────────────────────────────────────
# Points at the api service; the key must match BONITO_API_KEY.
BONITO_API_URL=http://api:8100