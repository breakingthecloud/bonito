# bonito-mcp v0.1.0 — image used by examples/docker-compose.yml (SSE transport).
FROM python:3.12-slim

WORKDIR /app

COPY bonito-store/ bonito-store/
RUN pip install --no-cache-dir ./bonito-store

COPY bonito-api/ bonito-api/
RUN pip install --no-cache-dir ./bonito-api

COPY bonito-mcp/ bonito-mcp/
RUN pip install --no-cache-dir ./bonito-mcp

EXPOSE 8840

CMD ["bonito-mcp", "--transport", "sse", "--sse-port", "8840"]