# bonito-collector v0.1.0 — environment template
# Copy to .env.bonito and adjust. See docs/configuration.md for details.

# REQUIRED — read-only PostgreSQL DSN (use the bonito_ro role from readonly-role.sql)
BONITO_DSN=postgresql://bonito_ro:change-me@localhost:5432/app

# Number of top queries / tables to collect (default 20)
# BONITO_TOP_N=20

# Optional — base URL of bonito-store (or cloud endpoint).
# Events are POSTed to <url>/events. Set this to push snapshots into the store.
BONITO_STORE_URL=http://localhost:8000

# Port for the Prometheus /metrics endpoint (default 9187)
# BONITO_PROM_PORT=9187