# bonito-store v0.1.0 — environment template
# For `bonito-store serve`. See docs/store.md.

# SQLite database file (default bonito.db)
BONITO_DB=bonito.db

# HTTP port (default 8000)
BONITO_STORE_PORT=8000

# Retention window in days — sample/event tables older than this are pruned
BONITO_RETENTION_DAYS=7