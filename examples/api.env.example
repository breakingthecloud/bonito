# bonito-api v0.1.0 — environment template
# For `bonito-api serve`. See docs/api.md.

# REQUIRED — API key for all data endpoints (X-API-Key / Bearer). Private deployment.
BONITO_API_KEY=change-me

# SQLite file written by bonito-store (default bonito.db)
BONITO_DB=bonito.db

# HTTP port (default 8100)
BONITO_API_PORT=8100